{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "prisma generate && prisma db push && next build",
  "framework": "nextjs",
  "regions": ["bom1"],
  "crons": [
    {
      "path": "/api/cron/send-scheduled",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "app/api/agent/chat/route.ts": {
      "maxDuration": 30
    },
    "app/api/webhooks/gmail/route.ts": {
      "maxDuration": 10
    }
  }
}
