# ============================================
# VALORA — Environment Variables
# Copy to .env and fill in all values
# ============================================

# --- APP ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- NEXTAUTH ---
# Generate with: openssl rand -base64 32 (or npx auth secret)
AUTH_SECRET=""

# --- GOOGLE OAUTH ---
# Get from: https://console.cloud.google.com/
# Add scopes: openid, email, profile, plus Gmail/Calendar scopes:
# https://www.googleapis.com/auth/gmail.readonly, https://www.googleapis.com/auth/gmail.send, https://www.googleapis.com/auth/gmail.modify, https://www.googleapis.com/auth/calendar.readonly, https://www.googleapis.com/auth/calendar.events
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- DATABASE (Postgres) ---
# Connection string to Neon PostgreSQL (neon.tech)
DATABASE_URL="postgresql://postgres:password@localhost:5432/valora"

# --- CORSAIR ---
# Master encryption key (KEK) for token storage — 32 bytes hex
# Generate with: openssl rand -hex 32
CORSAIR_KEK=""
CORSAIR_API_KEY="self_hosted"
NEXT_PUBLIC_CORSAIR_BASE_URL="http://localhost:3000/api/corsair"

# --- GROQ (AI — llama-3.3-70b-versatile + nomic-embed-text-v1.5) ---
# Get from: https://console.groq.com/
GROQ_API_KEY=""

# --- CORSAIR WEBHOOKS ---
# Shared secret for HMAC webhook signature verification
# Generate with: openssl rand -hex 32
CORSAIR_WEBHOOK_SECRET=""

# --- MEM0 (Agent Memory — optional) ---
# Get from: https://app.mem0.ai/
MEM0_API_KEY=""

# --- NGROK / LOCAL WEBHOOK TUNNEL ---
NGROK_URL=""

# --- FEATURE FLAGS ---
NEXT_PUBLIC_ENABLE_AGENT="true"
NEXT_PUBLIC_ENABLE_WEBHOOKS="true"
NEXT_PUBLIC_ENABLE_VECTOR_SEARCH="true"
NEXT_PUBLIC_ENABLE_SECURITY_SHIELD="true"
